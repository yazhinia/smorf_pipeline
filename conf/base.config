// Resources per process label. Values come from the production LSF wrappers in
// orf_prediction_run/submission_scripts/*_scheduler (see docs/provenance.md).

process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    // Whole-task failures from LSF memory/time kills (130/137/140) get one retry with
    // more memory; per-genome tool failures are soft and never reach here.
    errorStrategy = { task.exitStatus in [130, 137, 140] && task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'py_small' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 2.h
    }
    withLabel: 'py_chunk' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 6.h
    }
    withLabel: 'bakta' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        // 27 min/genome on average, 90 min first-pass timeout, 3 h retry for the slow ones
        time   = { 10.h + 1.h * task.attempt }
    }
    withLabel: 'smorfinder' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 12.h
    }
    withLabel: 'gmsc' {
        cpus   = 16
        memory = { params.gmsc_memory }
        time   = 10.h
        queue  = { params.gmsc_queue }   // LSF only; a second withLabel block elsewhere would replace this one
    }
    withLabel: 'orfipy' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 12.h
    }
    withLabel: 'hmmer' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = 12.h
    }
    withLabel: 'popcorn' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = 8.h
    }
}
