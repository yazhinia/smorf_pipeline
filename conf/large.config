// Large screens (thousands of genomes): submit the per-batch callers as LSF job arrays
// and allow more jobs in the queue at once. withName, not withLabel: a second withLabel
// block would replace the label's resources from base.config.

executor {
    queueSize = 3000
}

process {
    withName: 'BAKTA|SMORFINDER' {
        array = 100
    }
}
