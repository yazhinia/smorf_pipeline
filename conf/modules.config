// What each process publishes into --outdir. Per-chunk files are prefixed with their chunk
// id ('chunk_000001.<kind>'), which routes them to results/chunks/<chunk_id>/.

process {
    withName: 'PLAN_INPUTS' {
        publishDir = [path: "${params.outdir}/run_log", mode: params.publish_mode]
    }
    withName: 'NORMALIZE_CHUNK' {
        publishDir = [path: params.outdir, mode: params.publish_mode,
                      saveAs: { fn -> fn.endsWith('.genome_stats.tsv') || fn.endsWith('.contig_map.tsv')
                                      ? "chunks/${fn.tokenize('.')[0]}/${fn}" : null }]
    }
    // saveAs, not enabled: closures are read at publish time, after profiles set params
    withName: 'BAKTA|SMORFINDER|GMSC_EXTRACT|CUSTOM_CALLER|ORFIPY_NOVEL' {
        publishDir = [path: "${params.outdir}/intermediates", mode: params.publish_mode,
                      saveAs: { fn -> params.publish_intermediates ? fn : null }]
    }
    withName: 'MERGE_CHUNK' {
        publishDir = [path: params.outdir, mode: params.publish_mode,
                      saveAs: { fn -> fn.endsWith('_summary.tsv') || fn.endsWith('_skipped.tsv') || fn.endsWith('_combos.tsv')
                                      || params.publish_intermediates || params.stop_after == 'merge'
                                      ? "chunks/${fn.tokenize('.')[0]}/${fn}" : null }]
    }
    withName: 'COMBINE_CHUNK' {
        publishDir = [path: params.outdir, mode: params.publish_mode,
                      saveAs: { fn -> fn.endsWith('.dropped.tsv') || fn.endsWith('.combine_map.tsv')
                                      || params.publish_intermediates || params.stop_after == 'combine'
                                      ? "chunks/${fn.tokenize('.')[0]}/${fn}" : null }]
    }
    withName: 'JOIN_FLAGS' {
        publishDir = [path: params.outdir, mode: params.publish_mode,
                      saveAs: { fn -> "chunks/${fn.tokenize('.')[0]}/${fn}" }]
    }
    withName: 'STAGE_SUMMARY' {
        publishDir = [path: params.outdir, mode: params.publish_mode]
    }
    withName: 'COLLECT_RESULTS' {
        publishDir = [path: params.outdir, mode: params.publish_mode]
    }
}
