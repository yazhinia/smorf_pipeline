// Sanger farm: LSF executor, PaM module tree, work dir on /lustre.
// PaM tools are Singularity wrappers that bind /lustre and /data/pam only, never /tmp,
// so every task keeps its temp files inside its own work dir.

executor {
    name            = 'lsf'
    perJobMemLimit  = true
    queueSize       = 1000
    submitRateLimit = '10/1sec'
    pollInterval    = '10 sec'    // how often finished tasks are noticed
    killBatchSize   = 50
}

process {
    queue = { task.time <= 12.h ? 'normal' : (task.time <= 48.h ? 'long' : 'basement') }
    clusterOptions = { params.lsf_group ? "-G ${params.lsf_group}" : '' }
    scratch = false
    beforeScript = 'mkdir -p "$PWD/tmp"; export TMPDIR="$PWD/tmp" SINGULARITYENV_TMPDIR="$PWD/tmp"'
    // GMSC-Mapper's queue (params.gmsc_queue) is set with its label in base.config: repeating
    // withLabel: 'gmsc' here would replace that whole block (cpus, memory, time).
}
