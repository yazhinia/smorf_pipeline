// Small runs (<= small_run genomes; smorf_launch.sh adds this profile): the light Python steps
// run inside the Nextflow head job (2 cores, 8 GB) instead of as their own LSF jobs, which saves
// one queue wait per step. The tools (Bakta, smORFinder, GMSC-Mapper, orfipy, AntiFam, Popcorn,
// extra callers) still go to LSF. withName, not withLabel: a second withLabel block would
// replace the label's resources from base.config.

executor {
    $local {
        cpus   = 2
        memory = '4 GB'      // the head job's other 4 GB is Nextflow itself (-Xmx3g)
    }
}

process {
    withName: 'PLAN_INPUTS|NORMALIZE_CHUNK|GMSC_EXTRACT|MERGE_CHUNK|COMBINE_CHUNK|EXTRACT_SEQS|JOIN_FLAGS|STAGE_SUMMARY|COLLECT_RESULTS' {
        executor = 'local'
        cpus     = 1
        memory   = 2.GB
    }
}
