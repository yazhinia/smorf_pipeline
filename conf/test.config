// One E. coli isolate already in the catalog (HRGM2 GENOME148803 = gI053058), so every
// stage can be compared with the catalog's own outputs (bin/compare_to_catalog.py).

params {
    input  = "${projectDir}/assets/test_samplesheet.tsv"
    outdir = 'results'
    publish_intermediates = true    // tests/compare_to_catalog.py checks every tool output
}
