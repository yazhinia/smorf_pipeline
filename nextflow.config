// smorf_pipeline: genome FASTA -> candidate microproteins (small ORFs <= 100 aa).
// Reproduces the microprotein catalog build: Bakta + smORFinder + GMSC-Mapper merge
// (plus optional extra gene callers),
// orfipy novel intergenic ORFs, sequence hygiene, AntiFam and Popcorn flags.

manifest {
    name            = 'smorf_pipeline'
    description     = 'Microprotein (smORF) prediction from bacterial genomes, catalog method'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
}

params {
    // ---- input / output ------------------------------------------------------------
    input        = null      // FASTA file, directory of FASTAs, or samplesheet (.tsv/.csv: sample, fasta[, genome_id])
    split_mode   = 'file'    // file: one genome per file | record: one genome per FASTA record | regex: group records by split_regex
    split_regex  = null      // regex with one capture group applied to record IDs (split_mode = regex)
    id_prefix    = 'gU'      // genome ids are <id_prefix><000001>
    outdir       = 'results'
    publish_mode = 'copy'
    publish_intermediates = false   // also publish per-genome tool GFFs (large on big runs)
    concat_max_genomes    = 1000    // above this, final tables stay per chunk under results/chunks/

    // ---- run control (interactive checkpoints) ---------------------------------------
    stop_after   = 'flags'   // prepare | call | merge | combine | flags
    max_chunks   = 0         // >0: pilot run on the first N chunks only
    chunk_size   = 500       // genomes per chunk (GMSC-Mapper, merge, orfipy, combine, flags)
    bakta_batch  = 4         // genomes per Bakta task (1 when the run has <= small_run genomes)
    smorf_batch  = 20        // genomes per smORFinder task (1 when the run has <= small_run genomes)
    small_run    = 50

    // ---- catalog method constants ----------------------------------------------------
    max_aa       = 100
    orf_min      = 15        // orfipy, nt, excluding stop
    orf_max      = 300
    orf_starts   = 'ATG,GTG,TTG'
    orf_stops    = 'TAA,TAG,TGA'
    antifam_z    = 209244391 // hmmsearch -Z: catalog size, keeps E-values comparable to the catalog

    // ---- tools and databases (Sanger farm) -------------------------------------------
    module_dir        = '/software/modules'
    env_module        = 'PaM/environment'
    bakta_module      = 'bakta/1.11.0'      // catalog used bakta/1.11.4, no longer in the PaM tree
    bakta_db          = '/data/pam/software/bakta/v6.0'
    bakta_timeout     = '90m'
    bakta_retry_timeout = '3h'
    smorfinder_module = 'smorfinder/1.0.0'
    gmsc_module       = 'gmsc-mapper/0.1.0--pyhdfd78af_0'
    gmsc_db           = '/data/pam/software/gmsc-mapper/db'
    gmsc_queue        = 'normal'   // normal allows 683 GB/job; hugemem is capped at 500 jobs farm-wide
    gmsc_memory       = '200 GB'   // catalog setting; MMseqs2 search over the whole GMSC target DB
    hmmer_module      = 'hmmer/3.2.1--hfc679d8_0'
    // site paths: set in conf/site.config (template conf/site.config.example)
    antifam_hmm       = null
    orfipy_bin        = 'orfipy'
    popcorn_python    = 'python3'
    popcorn_dir       = null
    python_bin        = 'python3'
    singularity_module = 'singularityce-4.1.0'   // for extra callers with env: sif:<image>

    // ---- extra gene callers (merged after Bakta, GMSC-Mapper, smORFinder) --------------
    // List of {name, env, command, [description, batch, cpus, memory, time, timeout,
    // version_cmd]} in params.yaml; command uses {fasta} {gff} [{cpus} {gid} {tmp}].
    // bin/list_tools.py <run> shows and checks them; README "Adding a gene caller".
    extra_callers     = []

    // ---- dev feedback --------------------------------------------------------------
    feedback_dir = null      // shared folder that collects run_log/decisions.tsv copies

    lsf_group = null         // optional bsub -G
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
// Site paths (python_bin, orfipy_bin, popcorn_*, antifam_hmm); git ignores this file.
if (new File("${projectDir}/conf/site.config").exists()) { includeConfig 'conf/site.config' }

profiles {
    sanger { includeConfig 'conf/sanger_lsf.config' }
    large  { includeConfig 'conf/large.config' }
    small  { includeConfig 'conf/small.config' }
    test   { includeConfig 'conf/test.config' }
    local  {   // stub runs and tests on one node
        executor.name = 'local'
        process.resourceLimits = [cpus: 4, memory: 8.GB, time: 2.h]
    }
}

timeline { enabled = true; file = "${params.outdir}/run_log/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/run_log/report.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/run_log/trace.tsv"; overwrite = true
           fields = 'task_id,hash,native_id,process,tag,status,exit,submit,duration,realtime,%cpu,peak_rss,workdir' }
